{
  "name": "euskotrenbus",
  "main": "server/worker.js",
  "build": {
    "command": "npm run build"
  },
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "euskotrenbus-users",
      "database_id": "22e54801-bb76-4969-adff-d0ee5437fda2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "euskotrenbus-media"
    }
  ]
}
